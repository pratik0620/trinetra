rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TODO: Production rules must restrict users reading/writing their own profile
    // TODO: Production rules must restrict users creating connection requests
    // TODO: Production rules must restrict recipients reading their incoming requests
    // TODO: Production rules must restrict participants updating requests
    // TODO: Production rules must restrict users reading their own connections
    // TODO: Production rules must restrict users creating/updating their own emergency events

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection & Connections Subcollection
    match /users/{userId} {
      allow read, write: if true;

      match /connections/{connectionId} {
        allow read, write: if true;
      }

      match /fcm_tokens/{tokenId} {
        allow read, write: if true;
      }
    }

    // Connection Requests Collection
    match /connectionRequests/{requestId} {
      allow read, write: if true;
    }

    // Connections Collection
    match /connections/{connectionId} {
      allow read, write: if true;
    }

    // Devices Collection
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Emergencies Collection
    match /emergencies/{emergencyId} {
      allow read, write: if true;
    }

    // Safety Events Collection
    match /safety_events/{eventId} {
      allow read, write: if true;
    }
  }
}
